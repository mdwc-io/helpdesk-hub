---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="UK IT Help Desk Software Comparisons | HelpDesk Hub"
  description="Independent, UK-focused comparisons of IT help desk and service desk software. Written by a UK IT professional with real service-desk experience."
>
  <!-- Hero -->
  <section class="text-center py-10 sm:py-14">
    <h1 class="text-3xl sm:text-5xl font-bold text-gray-900 leading-tight mb-4">
      Find the right help desk software<br class="hidden sm:block" />
      <span class="text-blue-600">for your UK team</span>
    </h1>
    <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-8">
      Independent comparisons, real UK prices, and honest verdicts — written by a UK IT &amp; Facilities Manager who has run a service desk for years.
    </p>
    <a
      href="/it-help-desk-cost-calculator"
      class="inline-flex items-center gap-2 bg-blue-600 text-white font-semibold px-6 py-3 rounded-xl hover:bg-blue-700 transition-colors text-base shadow-sm"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 11h.01M12 11h.01M15 11h.01M4 19h16a2 2 0 002-2V7a2 2 0 00-2-2H4a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      Try the Cost Calculator
    </a>
  </section>

  <!-- Coming soon cards -->
  <section class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {[
      { href: "/it-help-desk-cost-calculator", label: "Cost Calculator", desc: "Compare annual costs for your team size across 6 platforms.", live: true },
      { href: "/best-help-desk-software-uk-small-business", label: "Best for UK Small Business", desc: "The hub guide — find the right tool for your sector.", live: true },
      { href: "/best-help-desk-software-uk-charities", label: "Best for UK Charities & Non-Profits", desc: "Free tiers, TechSoup pricing, and GDPR compliance.", live: true },
      { href: "/best-help-desk-software-uk-schools-mats", label: "Best for UK Schools & MATs", desc: "ICO compliance, MIS integration, MAT management.", live: true },
      { href: "/best-help-desk-software-uk-msps", label: "Best for UK MSPs", desc: "Multi-tenancy, SLA management, RMM integration.", live: true },
      { href: "/best-it-ticketing-uk-logistics-manufacturing", label: "Best for UK Logistics & Manufacturing", desc: "Shift-based ops, asset management, WMS integration.", live: true },
      { href: "/best-it-helpdesk-itsm-uk-smes", label: "Best Internal IT for UK SMEs", desc: "ITSM, asset tracking, and change management.", live: true },
      { href: "/best-help-desk-software-uk-ecommerce-retail", label: "Best for UK E-commerce & Retail", desc: "Live chat, Shopify integration, order support.", live: true },
      { href: "/best-help-desk-software-uk-accountancy-professional-services", label: "Best for Accountancy & Professional Services", desc: "CRM integration, client portals, data protection.", live: true },
      { href: "/best-help-desk-software-uk-property-lettings", label: "Best for UK Property & Lettings", desc: "Tenant maintenance, deposit disputes, live chat.", live: true },
      { href: "/freshdesk-vs-zoho-desk-uk", label: "Freshdesk vs Zoho Desk", desc: "Head-to-head for UK small businesses — pricing, features, verdict.", live: true },
      { href: "/freshservice-vs-jira-service-management", label: "Freshservice vs Jira Service Management", desc: "ITSM comparison for UK IT teams — ITIL, assets, dev integration.", live: true },
      { href: "/best-zendesk-alternatives-uk", label: "Best Zendesk Alternatives UK", desc: "The best options after Zendesk's price rises — with migration guide.", live: true },
      { href: "/best-free-help-desk-software-uk", label: "Best Free Help Desk Software UK", desc: "Honest guide to free tiers — what they include and where they stop.", live: true },
      { href: "/best-live-chat-ticketing-software-uk", label: "Best Live Chat & Ticketing UK", desc: "One tool or two? How to pick the right combination.", live: true },
    ].map(({ href, label, desc, live }) => (
      <a
        href={href}
        class={`group block rounded-xl border p-5 transition-all ${live ? "border-blue-200 bg-blue-50 hover:shadow-md" : "border-gray-200 bg-white cursor-default opacity-60"}`}
      >
        <div class="flex items-start justify-between mb-2">
          <p class="font-semibold text-gray-900 text-sm leading-snug">{label}</p>
          {live ? (
            <span class="inline-block text-xs font-medium bg-blue-600 text-white rounded-full px-2 py-0.5 ml-2 shrink-0">Live</span>
          ) : (
            <span class="inline-block text-xs font-medium bg-gray-200 text-gray-500 rounded-full px-2 py-0.5 ml-2 shrink-0">Soon</span>
          )}
        </div>
        <p class="text-xs text-gray-600">{desc}</p>
      </a>
    ))}
  </section>

  <!-- Trust statement -->
  <section class="mt-14 border-t border-gray-200 pt-10 grid sm:grid-cols-3 gap-8 text-sm text-gray-700">
    <div class="space-y-2">
      <div class="font-semibold text-gray-900">Written by a practitioner</div>
      <p>The owner is a UK IT &amp; Facilities Manager who actually runs a service desk — not an SEO agency or vendor-paid reviewer.</p>
    </div>
    <div class="space-y-2">
      <div class="font-semibold text-gray-900">UK-specific</div>
      <p>Prices in GBP, GDPR data residency flagged, UK support hours checked. Not a US review with "£" swapped in.</p>
    </div>
    <div class="space-y-2">
      <div class="font-semibold text-gray-900">Editorially independent</div>
      <p>Rankings are never paid for. Affiliate links are clearly labelled. Our reputation depends on honest advice.</p>
    </div>
  </section>
</Layout>
