---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = "Independent comparisons of UK IT help desk and service desk software. Real prices, honest verdicts, no vendor bias.",
  canonical,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <header class="border-b border-gray-200 bg-white sticky top-0 z-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-semibold text-gray-900 hover:text-blue-700 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>HelpDesk Hub UK</span>
        </a>
        <nav class="hidden sm:flex items-center gap-6 text-sm font-medium text-gray-600">
          <a href="/" class="hover:text-blue-700 transition-colors">Home</a>
          <a href="/it-help-desk-cost-calculator" class="hover:text-blue-700 transition-colors">Cost Calculator</a>
          <a href="/about" class="hover:text-blue-700 transition-colors">About</a>
        </nav>
        <!-- Mobile nav toggle — simple show/hide without JS for now -->
        <button
          id="mobile-menu-btn"
          class="sm:hidden p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100"
          aria-label="Open menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden sm:hidden border-t border-gray-200 bg-white px-4 py-3 flex flex-col gap-3 text-sm font-medium text-gray-700">
        <a href="/" class="hover:text-blue-700">Home</a>
        <a href="/it-help-desk-cost-calculator" class="hover:text-blue-700">Cost Calculator</a>
        <a href="/about" class="hover:text-blue-700">About</a>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>

    <footer class="border-t border-gray-200 bg-gray-50 mt-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 grid sm:grid-cols-3 gap-8 text-sm text-gray-600">
        <div>
          <p class="font-semibold text-gray-900 mb-2">HelpDesk Hub UK</p>
          <p>Independent comparisons of IT help desk &amp; service desk software, written by a UK IT &amp; Facilities Manager with real service-desk experience.</p>
        </div>
        <div>
          <p class="font-semibold text-gray-900 mb-2">Navigation</p>
          <ul class="space-y-1">
            <li><a href="/" class="hover:text-blue-700">Home</a></li>
            <li><a href="/it-help-desk-cost-calculator" class="hover:text-blue-700">Cost Calculator</a></li>
            <li><a href="/about" class="hover:text-blue-700">About &amp; Editorial Policy</a></li>
          </ul>
        </div>
        <div>
          <p class="font-semibold text-gray-900 mb-2">Editorial Independence</p>
          <p>Our rankings are based entirely on editorial judgement. We are not paid for placement. Some links are affiliate links — we may earn a commission if you sign up, at no extra cost to you. <a href="/about#affiliate-disclosure" class="underline hover:text-blue-700">Full disclosure →</a></p>
        </div>
      </div>
      <div class="border-t border-gray-200 max-w-5xl mx-auto px-4 sm:px-6 py-4 text-xs text-gray-400">
        &copy; {new Date().getFullYear()} HelpDesk Hub UK. All prices shown are indicative — verify current pricing with each vendor before purchasing.
      </div>
    </footer>

    <script>
      const btn = document.getElementById("mobile-menu-btn");
      const menu = document.getElementById("mobile-menu");
      if (btn && menu) {
        btn.addEventListener("click", () => menu.classList.toggle("hidden"));
      }
    </script>
  </body>
</html>
