---
import type { Software } from "../data/software";

interface Props {
  product: Software;
  verdict: string;
  rank?: number;
}

const { product, verdict, rank } = Astro.props;

// Build star display: filled ★ up to rounded rating, empty ☆ after
const fullStars = Math.round(product.rating);
---

<div class="border border-gray-200 rounded-xl p-5 sm:p-6 space-y-4 hover:shadow-sm transition-shadow">
  <div class="flex items-start justify-between gap-3">
    <div>
      {rank && (
        <span class="inline-block text-xs font-semibold bg-blue-600 text-white rounded-full px-2.5 py-0.5 mb-2">
          #{rank} Pick
        </span>
      )}
      <h3 class="text-lg font-bold text-gray-900">{product.name}</h3>
      <p class="text-sm text-gray-500">{product.vendor}</p>
    </div>
    <div class="text-right shrink-0">
      <div class="flex items-center justify-end gap-0.5 mb-0.5">
        {Array.from({ length: 5 }, (_, i) => (
          <span class={`text-base ${i < fullStars ? "text-amber-400" : "text-gray-200"}`}>★</span>
        ))}
      </div>
      <span class="text-sm font-semibold text-gray-700">{product.rating.toFixed(1)}<span class="text-gray-400 font-normal">/5</span></span>
    </div>
  </div>

  <!-- Verdict -->
  <p class="text-sm text-gray-700 italic border-l-4 border-blue-200 pl-3">{verdict}</p>

  <!-- Pros / Cons -->
  <div class="grid sm:grid-cols-2 gap-3 text-sm">
    <div>
      <p class="font-semibold text-gray-900 mb-1.5">Pros</p>
      <ul class="space-y-1">
        {product.pros.slice(0, 3).map((pro) => (
          <li class="flex items-start gap-1.5 text-gray-700">
            <span class="text-green-500 mt-0.5 shrink-0">✓</span> {pro}
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="font-semibold text-gray-900 mb-1.5">Cons</p>
      <ul class="space-y-1">
        {product.cons.slice(0, 2).map((con) => (
          <li class="flex items-start gap-1.5 text-gray-700">
            <span class="text-red-400 mt-0.5 shrink-0">✗</span> {con}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Meta row -->
  <div class="flex flex-wrap gap-3 text-xs text-gray-600 border-t border-gray-100 pt-3">
    <span>
      <span class="text-gray-400">From:</span>
      <strong class="text-gray-900 ml-1">
        {product.startingPriceGBP === 0 ? "Free" : `£${product.startingPriceGBP}/agent/mo`}
      </strong>
    </span>
    <span>
      <span class="text-gray-400">Free tier:</span>
      <strong class={`ml-1 ${product.freeTier ? "text-green-600" : "text-gray-500"}`}>
        {product.freeTier ? "Yes" : "No"}
      </strong>
    </span>
    <span>
      <span class="text-gray-400">UK/EU hosting:</span>
      <strong class={`ml-1 ${product.ukHosting ? "text-green-600" : "text-gray-500"}`}>
        {product.ukHosting ? "Yes" : "No"}
      </strong>
    </span>
    <span>
      <span class="text-gray-400">Via:</span>
      <strong class="text-gray-900 ml-1">{product.affiliate.network}</strong>
    </span>
  </div>

  <a
    href={product.affiliate.url}
    target="_blank"
    rel="sponsored nofollow noreferrer"
    class="flex items-center justify-center gap-2 bg-blue-600 text-white text-sm font-semibold rounded-xl px-4 py-2.5 hover:bg-blue-700 transition-colors"
  >
    Try {product.name} →
  </a>
</div>
